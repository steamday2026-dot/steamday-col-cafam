:root{
  --bg:#eef1f6; --ink:#1b2333; --muted:#6b7487; --line:#e2e6ee; --card:#fff;
  --brand:#173d7a; --accent:#f2a900;
  --mat:#2f6fde; --cie:#1f9d6b; --tec:#7b4bd6; --gen:#5b6577; --ok:#1f9d6b; --bad:#e5484d;
  --safe-top:env(safe-area-inset-top,0px); --safe-bot:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);overscroll-behavior:none}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:15px}
[hidden]{display:none !important}
.sm{font-size:12px;color:var(--muted)}
.pend{color:#9aa3b5;font-style:italic}

/* contenedor móvil */
.screen{position:fixed;inset:0;display:flex;flex-direction:column;max-width:520px;margin:0 auto;background:#fff;overflow:hidden}
.screen.wide{max-width:none;background:var(--bg)}
@media(min-width:521px){.screen:not(.wide){box-shadow:0 0 0 1px var(--line),0 10px 40px rgba(20,30,60,.12)}}

/* logo */
.logo{display:flex;align-items:center;gap:10px}
.mark{width:38px;height:38px;border-radius:10px;background:var(--brand);display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:6px;flex:none}
.mark i{border-radius:3px}
.mark i:nth-child(1){background:var(--mat)}.mark i:nth-child(2){background:var(--accent)}
.mark i:nth-child(3){background:var(--cie)}.mark i:nth-child(4){background:var(--tec)}
.logo b{font-size:17px;display:block;line-height:1.1}
.logo small{font-size:11px;color:var(--muted)}

/* botones y campos */
.btn{background:var(--brand);color:#fff;border:0;border-radius:12px;padding:14px;font-weight:700;font-size:15px;width:100%}
.btn:disabled{opacity:.5}
.btn.alt{background:var(--accent);color:#1b2333}
.btn.ghost{background:transparent;color:var(--brand);border:1px solid var(--brand)}
.btn.ghostw{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.45)}
.b1{background:var(--brand);color:#fff;border:0;border-radius:8px;padding:9px 14px;font-size:13px;font-weight:700}
.b2{border:1px solid var(--brand);color:var(--brand);background:#fff;border-radius:8px;padding:9px 14px;font-size:13px;font-weight:700}
.field label{font-size:12px;color:var(--muted);display:block;margin-bottom:5px}
.field input,.field select,.field textarea{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:10px;background:#fff}
.err{color:var(--bad);font-size:13px;min-height:18px}
.chip{display:inline-block;font-size:13px;padding:7px 12px;border-radius:20px;border:1px solid var(--line);background:#fff;cursor:pointer;user-select:none}
.chip.on{border-color:var(--brand);background:#e9effa;color:var(--brand);font-weight:700}
.row{display:flex;gap:8px;flex-wrap:wrap}
.sw{width:32px;height:32px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px var(--line);cursor:pointer;flex:none}
.sw.on{box-shadow:0 0 0 2px var(--brand)}

/* pantallas simples */
.pad{padding:calc(28px + var(--safe-top)) 24px calc(24px + var(--safe-bot));display:flex;flex-direction:column;gap:16px;flex:1;overflow:auto}
.login{background:linear-gradient(180deg,#f6f8fc 0%,#fff 45%)}
.datebox{background:var(--brand);color:#fff;border-radius:14px;padding:16px}
.datebox small{opacity:.8;font-size:12px}.datebox div{font-size:20px;font-weight:700;margin-top:2px}
.note{font-size:12px;color:var(--muted);text-align:center}
.pad h2{font-size:21px;line-height:1.25}
.pad p{font-size:14px;color:var(--muted);line-height:1.45}
.cc{border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:#fff}
.cc .big{font-size:26px;font-weight:800;color:var(--brand)}
.cc .r{font-size:13px;margin-top:4px}.cc .r span{color:var(--muted)}
.exp{display:flex;gap:12px;align-items:center;border:2px solid var(--line);border-radius:14px;padding:12px;cursor:pointer;background:#fff}
.exp.on{border-color:var(--c);background:color-mix(in srgb,var(--c) 8%,#fff)}
.exp .ico{width:46px;height:46px;border-radius:12px;background:var(--c);color:#fff;display:grid;place-items:center;font-size:22px;font-weight:800;flex:none}
.exp b{display:block;font-size:15px}.exp small{font-size:12px;color:var(--muted)}
.bottom{margin-top:auto;display:flex;flex-direction:column;gap:8px}

/* video */
.video{background:#0f1b33;color:#fff}
.video .pad p{color:rgba(255,255,255,.75)}
.vbox{border-radius:16px;overflow:hidden;background:#000;aspect-ratio:9/16;max-height:52vh;width:100%}
.vbox video,.vbox iframe{width:100%;height:100%;border:0;display:block}
.vempty{display:grid;place-items:center;height:100%;background:linear-gradient(160deg,#2f6fde 0%,#7b4bd6 55%,#1f9d6b 100%);font-size:14px;text-align:center;padding:20px}

/* cabecera azul */
.ahead{padding:calc(16px + var(--safe-top)) 18px 16px;background:var(--brand);color:#fff}
.ahead small{opacity:.8;font-size:12px}.ahead h2{font-size:19px;margin-top:2px}

/* avatar */
.stage{height:190px;display:grid;place-items:center;background:radial-gradient(circle at 50% 70%,#dfe9ff 0%,#f6f8fc 60%);flex:none}
.atabs{display:flex;border-bottom:1px solid var(--line);flex:none}
.atabs span{flex:1;text-align:center;font-size:14px;padding:11px 0;color:var(--muted);cursor:pointer}
.atabs span.on{color:var(--brand);font-weight:700;box-shadow:inset 0 -3px 0 var(--brand)}
.opts{padding:12px 16px;flex:1;overflow:auto}
.opt{margin-bottom:14px}
.opt h4{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:7px}
.foot{padding:12px 16px calc(12px + var(--safe-bot));border-top:1px solid var(--line);flex:none}

/* alertas */
.perm{border-radius:12px;padding:10px 12px;margin:4px 0 12px;font-size:13px}
.perm.ok{background:#e8f6ef;border:1px solid #b7e2cc}
.perm.no{background:#fff3e6;border:1px solid #f5cf9a}
.perm span{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.set{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.set b{font-size:14px;display:block}.set small{font-size:12px;color:var(--muted)}
.tg{position:relative;width:46px;height:28px;flex:none}
.tg input{display:none}
.tg i{position:absolute;inset:0;background:#cdd3df;border-radius:20px;transition:.2s;cursor:pointer}
.tg i:after{content:"";position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.tg input:checked+i{background:var(--ok)}
.tg input:checked+i:after{left:21px}
.nx{display:flex;gap:12px;align-items:center;padding:8px 10px;border:1px solid var(--line);border-radius:10px;margin-bottom:6px}
.nx span{font-weight:700;font-size:13px;color:var(--brand);width:62px;flex:none}
.nx b{font-size:13px;display:block}.nx small{font-size:12px;color:var(--muted)}

/* principal */
.mtop{background:var(--brand);color:#fff;padding:calc(12px + var(--safe-top)) 14px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex:none}
.mtop small{opacity:.8;font-size:12px}
.mtop h2{font-size:17px;margin-top:1px}
.mtop .right{display:flex;gap:8px;align-items:center}
.iconbtn{width:34px;height:34px;border-radius:50%;background:#fff;color:var(--brand);font-weight:800;display:grid;place-items:center;cursor:pointer;font-size:16px;border:0;flex:none}
.chips{display:flex;gap:6px;padding:8px 12px;background:#f3f6fc;border-bottom:1px solid var(--line);flex-wrap:wrap;align-items:center;flex:none}
.chips span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;background:#fff;border:1px solid var(--line);cursor:pointer}
.chips span.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.chips .sep{width:1px;height:18px;background:var(--line);padding:0;border:0;border-radius:0}
.chips small{margin-left:auto;color:var(--muted);font-size:11px}
.progress{display:flex;align-items:center;gap:8px;padding:8px 14px;background:#f3f6fc;font-size:12px;color:var(--muted);flex:none}
.pbar{flex:1;height:7px;background:#dde3ef;border-radius:6px;overflow:hidden}
.pbar i{display:block;height:100%;background:var(--accent);border-radius:6px;transition:width .8s}
.banner{background:#fff8e6;border-bottom:1px solid #f5d98a;padding:8px 14px;font-size:12.5px;flex:none}
.banner b{display:block}
.map{flex:1;position:relative;overflow:hidden;background:#9fd08a;min-height:0}
.map>svg{width:100%;height:100%;display:block;touch-action:manipulation}
.node{cursor:pointer}
.node text{font-size:11px;font-weight:800;fill:#fff;text-anchor:middle;dominant-baseline:central;pointer-events:none}
.zoomtag{position:absolute;top:8px;right:8px;background:rgba(15,27,51,.75);color:#fff;font-size:11px;padding:4px 9px;border-radius:12px;opacity:0;transition:opacity .3s}
.zoomtag.on{opacity:1}
.card{position:relative;margin:8px 10px;background:#fff;border-radius:14px;padding:10px 46px 10px 12px;box-shadow:0 4px 16px rgba(0,0,0,.12);border-left:5px solid var(--c,var(--tec));cursor:pointer;flex:none}
.card .k{font-size:10px;font-weight:800;color:var(--c,var(--tec));text-transform:uppercase;letter-spacing:.06em}
.card .t{font-weight:700;font-size:14px;margin-top:2px}
.card .m{font-size:12px;color:var(--muted);margin-top:2px}
.card .go{position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:12px;color:var(--brand);font-weight:700}
.nav{display:flex;border-top:1px solid var(--line);background:#fff;padding-bottom:var(--safe-bot);flex:none}
.nav span{flex:1;text-align:center;font-size:11px;padding:9px 0;color:var(--muted);cursor:pointer}
.nav span.on{color:var(--brand);font-weight:700}
.nav span i{display:block;font-style:normal;font-size:17px;margin-bottom:2px}
.panel{flex:1;overflow:auto;min-height:0;display:flex;flex-direction:column}

/* lista */
.lista{padding:12px 14px}
.li{display:flex;gap:10px;border:1px solid var(--line);border-left:5px solid var(--c);border-radius:12px;padding:10px 12px;margin-bottom:8px;cursor:pointer}
.li.done{opacity:.55}.li.cur{box-shadow:0 0 0 3px color-mix(in srgb,var(--c) 22%,transparent)}
.li .h{font-weight:800;font-size:13px;width:64px;flex:none}
.li b{display:block;font-size:14px}.li small{font-size:12px;color:var(--muted)}

/* hoja inferior */
.sheet{position:absolute;left:0;right:0;bottom:0;top:18%;background:#fff;border-radius:20px 20px 0 0;box-shadow:0 -8px 24px rgba(0,0,0,.2);transform:translateY(105%);transition:transform .3s;display:flex;flex-direction:column;z-index:8}
.sheet.open{transform:none}
.sheet .sh{padding:16px 18px;color:#fff;border-radius:20px 20px 0 0;flex:none;position:relative}
.sheet .sh .x{position:absolute;top:10px;right:10px;z-index:2;cursor:pointer;font-size:13px;font-weight:700;background:rgba(255,255,255,.2);border-radius:20px;padding:6px 12px}
.sheet .sh h3{font-size:19px;margin-top:6px}
.sheet .sh .tag2{display:inline-block;margin-top:6px;background:rgba(255,255,255,.22);border-radius:20px;padding:3px 10px;font-size:12px}
.sheet .sb{overflow:auto;padding-bottom:calc(16px + var(--safe-bot));flex:1}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px}
.fact{background:#f6f7fb;border-radius:12px;padding:10px 12px}
.fact small{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.fact div{font-weight:600;font-size:14px;margin-top:3px}
.sec{padding:0 16px 14px}
.sec h3{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.sec p{font-size:14px;line-height:1.45}
.lockmsg{margin:12px 16px 0;background:#eef2fa;border-radius:10px;padding:9px 12px;font-size:12.5px;color:var(--brand)}
.alertbox{margin:12px 16px 0;background:#fff8e6;border:1px solid #f5d98a;border-radius:10px;padding:9px 12px;font-size:12.5px}
.rot{margin:0 16px 8px;border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:13px;display:flex;justify-content:space-between;gap:10px}
.rot span{color:var(--muted);font-size:12px;text-align:right}
.hsel{padding:14px 16px}
.hsel h4{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:12px 0 7px}

/* programa general */
.gtabs{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid var(--line);flex:none}
.gtabs span{font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;border:1px solid var(--line);cursor:pointer}
.gtabs span.on{background:var(--brand);color:#fff;border-color:var(--brand)}
.legend2{display:flex;gap:10px;flex-wrap:wrap;padding:6px 12px 6px;font-size:11px;color:var(--muted)}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:middle}
.gwrap{padding:4px 6px 12px;overflow:auto}
.gt{width:100%;border-collapse:separate;border-spacing:3px;font-size:10.5px}
.gt th{font-size:10px;color:var(--muted);padding:4px 2px;text-align:center;font-weight:700}
.gt td{padding:6px 4px;border-radius:6px;vertical-align:middle;line-height:1.25}
.gt td.h{font-weight:700;background:#f3f5fa;white-space:nowrap;font-size:10px}
.gt td.c{color:#fff;font-weight:600}
.gt td.c small{display:block;font-weight:400;opacity:.9;font-size:9.5px}
.gt td.p{background:#fff3d1;color:#7a5a00;text-align:center;font-weight:700}

/* modal de alerta */
.modal{position:absolute;inset:0;background:rgba(15,27,51,.55);display:flex;align-items:flex-end;padding:10px;z-index:20}
.mbox{background:#fff;border-radius:20px;padding:18px;width:100%;padding-bottom:calc(18px + var(--safe-bot))}
.mbox .k{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.mbox h3{font-size:20px;margin:3px 0 10px}
.mi{display:flex;gap:8px;font-size:14px;margin-bottom:6px}
.mbox p{font-size:13px;color:var(--muted);margin:8px 0 14px;line-height:1.45}
.bell{width:52px;height:52px;border-radius:50%;background:#fff3d1;display:grid;place-items:center;font-size:26px;margin-bottom:8px;animation:ring .5s ease-in-out 6}
@keyframes ring{0%,100%{transform:rotate(0)}25%{transform:rotate(-18deg)}75%{transform:rotate(18deg)}}
.toast{position:fixed;left:50%;transform:translateX(-50%);top:calc(70px + var(--safe-top));background:#1b2333;color:#fff;border-radius:12px;padding:10px 14px;font-size:13px;z-index:50;opacity:0;transition:opacity .3s;pointer-events:none;max-width:90%}
.toast.on{opacity:1}
.toast.ok{background:var(--ok)}.toast.bad{background:var(--bad)}
.loading{position:fixed;inset:0;display:grid;place-items:center;background:#fff;z-index:100;font-size:14px;color:var(--muted)}
.spin{width:36px;height:36px;border:4px solid #dde3ef;border-top-color:var(--brand);border-radius:50%;animation:sp 1s linear infinite;margin:0 auto 12px}
@keyframes sp{to{transform:rotate(360deg)}}

/* administración */
.adm{max-width:1200px;margin:0 auto;padding:20px 16px 60px;width:100%;overflow:auto;flex:1;min-height:0;-webkit-overflow-scrolling:touch}
.adm .top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.desk{background:#fff;border-radius:14px;border:1px solid var(--line);overflow:hidden}
.tabs{display:flex;gap:4px;padding:10px 14px 0;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.tabs span{font-size:13px;padding:9px 14px;border-radius:8px 8px 0 0;color:var(--muted);cursor:pointer}
.tabs span.on{background:#f3f5fa;color:var(--brand);font-weight:700}
.tbody{padding:16px 18px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.tools select,.tools input{padding:8px 10px;border:1px solid var(--line);border-radius:8px;font-size:13px}
.twrap{overflow-x:auto}
table.t{width:100%;border-collapse:collapse;font-size:13px}
table.t th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
table.t td{padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
table.t td input{width:100%;min-width:90px;padding:6px 8px;border:1px solid var(--line);border-radius:6px;font-size:13px}
.drop{border:2px dashed #c7d2e8;border-radius:12px;padding:22px;text-align:center;font-size:14px;color:var(--muted);cursor:pointer}
.drop.over{background:#eef2fa}
.drop b{color:var(--brand)}
.stat{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:14px 0}
.stat div{background:#f6f7fb;border-radius:10px;padding:10px 12px}
.stat b{display:block;font-size:22px;color:var(--brand)}.stat span{font-size:12px;color:var(--muted)}
.warnbox{background:#fff8e6;border:1px solid #f5d98a;border-radius:10px;padding:10px 14px;font-size:13px;margin:10px 0}
.warnbox ul{margin:6px 0 0 18px}
.okbox{background:#e8f6ef;border:1px solid #b7e2cc;border-radius:10px;padding:10px 14px;font-size:13px;margin:10px 0}
